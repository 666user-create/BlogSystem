# ===== Maven =====
target/
*.class

# ===== IDE =====
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# ===== 日志 =====
*.log
*.log.*
*.gz

# ===== 系统文件 =====
.DS_Store
Thumbs.db

# ===== 本地环境配置（含数据库密码等敏感信息）=====
application-local.yml
application-local.properties

# ===== 本地测试工具（Allure/JMeter 等，不入库）=====
.tools/

# ===== 测试报告（可再生的生成物，用命令重新生成，不入库）=====
# Allure / JMeter 原始数据与计划文件是入库的，HTML 报告目录不入库
allure-results/
reports/
perf/report/

# ===== 数据库备份（含真实数据，不入库）=====
backup/

# ===== 微服务运行时产物（Nacos 启动时会往当前工作目录写这些，已统一收进 blog-cloud/）=====
blog-cloud/logs/
blog-cloud/work/
blog-cloud/derby.log

# ===== 性能测试运行日志 =====
perf/jmeter.log
