# ===== Maven =====
target/
*.class

# ===== IDE =====
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# ===== 日志 =====
*.log
*.log.*
*.gz

# ===== 系统文件 =====
.DS_Store
Thumbs.db

# ===== 本地环境配置（含数据库密码等敏感信息）=====
application-local.yml
application-local.properties

# ===== 本地测试工具（Allure/JMeter 等，不入库）=====
.tools/

# ===== 测试报告（可再生的生成物，用命令重新生成，不入库）=====
# Allure / JMeter 原始数据与计划文件是入库的，HTML 报告目录不入库
allure-results/
reports/
perf/report/

# ===== 数据库备份（含真实数据，不入库）=====
backup/

# ===== 微服务运行时产物（Nacos 启动时会往当前工作目录写这些，已统一收进 blog-cloud/）=====
blog-cloud/logs/
blog-cloud/work/
blog-cloud/derby.log

# ===== 性能测试运行日志 =====
perf/jmeter.log

# ===== 应用运行日志（单体工程，已统一收进 logs/）=====
logs/

# ===== Python 缓存 =====
__pycache__/
*.py[cod]
.pytest_cache/

# ===== 测试证据与压测原始数据（跑测试/压测时本地生成，不入库）=====
# 这些是"跑一次就有"的产物，体积大且会随每次执行变化，仓库只保留可复现的脚本与结论：
#   UI 截图/弹框文本：mvn test -Dtest=BlogUiTest
#   抓包证据：        python -m pytest test_security_capture.py
#   JMeter 原始结果： jmeter -n -t perf/BlogSystem-性能测试计划.jmx -l perf/result.jtl -e -o perf/report
docs/test-evidence/
perf/result.jtl
