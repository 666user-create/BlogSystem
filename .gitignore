# ===== Maven =====
target/
*.class

# ===== IDE =====
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# ===== 日志 =====
*.log
*.log.*
*.gz

# ===== 系统文件 =====
.DS_Store
Thumbs.db

# ===== 本地环境配置（含数据库密码等敏感信息）=====
application-local.yml
application-local.properties

# ===== 本地测试工具（Allure/JMeter 等，不入库）=====
.tools/

# ===== 数据库备份（含真实数据，不入库）=====
# backup/ 放两类东西：
#   backup/*.sql        数据库快照（含真实数据，不入库）
#   backup/scripts/     辅助脚本（测试数据清理、binlog 恢复，属于可复现资产，继续入库）
backup/*
!backup/scripts/

# ===== 微服务运行时产物（Nacos 启动时会往当前工作目录写这些，已统一收进 blog-cloud/）=====
blog-cloud/logs/
blog-cloud/work/
blog-cloud/derby.log

# ===== 应用运行日志（单体工程，已统一收进 logs/）=====
logs/

# ===== Python 缓存 =====
__pycache__/
*.py[cod]
.pytest_cache/

# ===== 测试生成物（跑一次就有，不入库）=====
# tests/ 下只有"可复现的资产"入库：api-python/（用例）、perf/（.jmx 计划）
# 下面这两类是产出物，体积大且每次执行都变，统一收在 tests/ 下，整体忽略：
#   tests/evidence/  UI 截图 + 弹框文本 + 抓包 json
#   tests/reports/   JMeter 原始结果/HTML Dashboard、Allure 原始结果/HTML 报告
#
# 生成命令：
#   UI 截图：      mvn test -Dtest=BlogUiTest
#   抓包证据：     cd tests/api-python && python -m pytest test_security_capture.py
#   性能测试：     jmeter -n -t tests/perf/BlogSystem-性能测试计划.jmx -l tests/reports/jmeter/result.jtl -e -o tests/reports/jmeter
tests/evidence/
tests/reports/
tests/perf/jmeter.log
jmeter.log
# 兜底：万一 Java 侧 allure 没走 src/test/resources/allure.properties 的改道配置，
# 默认仍会在仓库根目录生成 allure-results/
allure-results/
